# processor
CONFIG_X86_MCE=y

# power management
CONFIG_ACPI=y
CONFIG_INTEL_IDLE=y

# drivers
CONFIG_PCCARD=n
CONFIG_PARPORT=m
CONFIG_PARPORT_PC=m
CONFIG_PARPORT_PC_FIFO=y
CONFIG_PARPORT_1284=y
CONFIG_BLK_DEV_FD=m

# ethernet
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m

# input
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PCSPKR=y

# chardev
CONFIG_NVRAM=m

# graphics
# retro
CONFIG_AGP=n
# DRM
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_I915=y
CONFIG_DRM_XE=n
CONFIG_DRM_GMA500=y
