{
    "compilerOptions": {
        "target": "ES6",         // JavaScript version to compile to
        "module": "commonjs",    // Module system
        "outDir": "./static",    // Output directory
        "strict": true,          // Enable strict type checking
        "esModuleInterop": true
    },
    "include": ["lib/**/*.ts"],
    "exclude": ["node_modules"]
}
