def cmake():
    cp('CMakeLists.txt')
    presets()
    mkd('cmake')


def vscode():
    d = '.vscode'
    f = 'settings', 'extensions', 'launch', 'tasks', 'c_cpp_properties'
    mkd(d)
    for i in f:
        cp(f'{d}/{i}.json')


def apt():
    for i in ['Debian', 'Msys']:
        touch(f'apt.{i}')


def gen():
    rc()
    readme()
    dirs()
    giti()
    cross()
    mk()
    cmake()
    vscode()
    apt()


gen()
