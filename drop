#!/usr/bin/python3

import datetime
import os as _os

CWD = _os.getcwd()
MODULE = CWD.split('/')[-1]
ABOUT = 'embedded drop/down infrastructure'
AUTHOR = 'Dmitry Ponyatov'
EMAIL = 'dponyatov@gmail.com'
YEAR = datetime.date.today().year
LICENSE = 'MIT'


def add(f): _os.system(f'git add {f}')
def touch(f): open(f, 'a').close(); add(f)
def cp(f): _os.system(f'cp ~/em/{f} {f}'); add(f)


def mkd(d):
    try:
        _os.mkdir(d)
    except FileExistsError:
        pass
    touch(f'{d}/.gitignore')


def rc():
    _os.system('ln -fs ../rc rc && git add rc')


def readme():
    md = 'README.md'
    with open(md, 'w') as f:
        print(f'''# ![](doc/logo.png) `{MODULE}`
## {ABOUT}
\n(c) {AUTHOR} <<{EMAIL}>> {YEAR} {LICENSE}
\n github: https://github.com/ponyatov/pyc/{MODULE}
gitflic: https://gitflic.ru/project/dponyatov/{MODULE}''', file=f)
    add(md)


def dirs():
    for d in ['.', '.vscode', 'bin', 'doc', 'lib', 'inc', 'src', 'tmp', 'ref']:
        mkd(d)
    for i in ['bin', 'doc', 'tmp', 'ref']:
        cp(f'{i}/.gitignore')


def giti():
    for i in ['bin', 'ref', 'tmp']:
        with open(f'{i}/.gitignore', 'w') as f:
            print('*', file=f)


HW = {'pc': 'i5', 'pillF103': 'stm32f103c8t', 'f4disco': 'stm32f407vgt'}
CPU = {'i5': 'x86_64', 'stm32f103c8t': 'cortexM3', 'stm32f407vgt': 'cortexM4'}


def hw():
    h = HW.keys()
    mkd('hw')
    for i in h:
        mkd(f'hw/{i}')
        for j in ['inc', 'src']:
            mkd(f'hw/{i}/{j}')
        for k in ['cmake', 'ocd', 'gdb']:
            touch(f'hw/{i}/{i}.{k}')
        mk = f'hw/{i}/{i}.mk'
        with open(mk, 'w') as m:
            print(f'CPU = {HW[i]}', file=m)
        add(mk)


def cpu():
    c = CPU.keys()
    mkd('cpu')
    for i in c:
        mkd(f'cpu/{i}')
        for j in ['inc', 'src']:
            mkd(f'cpu/{i}/{j}')
        touch(f'cpu/{i}/{i}.cmake')
        mk = f'cpu/{i}/{i}.mk'
        with open(mk, 'w') as m:
            print(f'ARCH = {CPU[i]}', file=m)
        add(mk)


def arch(): mkd('arch')
def os(): mkd('os')


def cross():
    hw()
    cpu()
    arch()
    os()


def mk():
    mkd('mk')
    touch('Makefile')


