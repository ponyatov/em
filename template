#!/usr/bin/make -f

M ?= $(notdir  $(CURDIR)       )
D  = $(abspath $(HOME)/$(M)    )
L  = $(abspath $(MAKEFILE_LIST))
T  = $(abspath $(dir $(L))     )

.PHONY: template
template:
	mkdir -p $(D)
	$(MAKE) -f $(L) -C $(D) M=$(M) git dirs giti vscode files doc cmake mk hw lib

.PHONY: git
git: .git
.git:
	git init
	git remote add gh    git@github.com:ponyatov/$(M).git
	git remote add flic git@gitflic.ru:dponyatov/$(M).git
#
	git checkout --orphan dev
	ln -fs ../rc rc ; git add rc ; git commit -am "."
	git push -v -u gh dev
#
	git checkout --orphan `whoami`
	ln -fs ../rc rc ; git add rc ; git commit -am "."
	git push -v -u gh   `whoami`
	git push       flic `whoami`

DIRS  = $(shell find $(T)/* -maxdepth 0 -type d)
DIRS += $(shell find $(T)/doc/* -maxdepth 1 -type d)
DIRS := $(patsubst $(T)/%,$(D)/%,$(DIRS)) $(D)/.vscode

.PHONY: dirs
dirs:
	mkdir -p $(DIRS)

GITI = $(patsubst %,%/.gitignore,$(DIRS))

.PHONY: giti
giti:
	touch $(GITI)
	@echo '*~'           > $(D)/.gitignore
	@echo '*.swp'       >> $(D)/.gitignore
	@echo '*.log'       >> $(D)/.gitignore
	@echo '!.gitignore' >> $(D)/.gitignore
	@echo 'html/'        > $(D)/doc/.gitignore
	@echo '*'            > $(D)/bin/.gitignore
	@echo '*'            > $(D)/ref/.gitignore
	@echo '*'            > $(D)/tmp/.gitignore
	@echo '.mxproject'  >> $(D)/hw/.gitignore

.PHONY: files
files: \
		$(D)/.clang-format $(D)/README.md $(D)/.doxygen $(D)/LICENSE \
		$(D)/.gitattributes $(D)/.prettierrc $(D)/Dockerfile \
		$(D)/doc/DoxygenLayout.xml $(D)/doc/logo.png
	touch \
		$(D)/apt.Debian $(D)/apt.Msys

$(D)/%: $(T)/% $(L)
	cp $< $@

.PHONY: readme
readme: $(D)/README.md
$(D)/README.md: $(L)
	@echo "# \`$(M)\`"                                            > $@
	@echo "## $(D)"                                              >> $@
	@echo                                                        >> $@
	@echo "(c) Dmitry Ponyatov <<dponyatov@gmail.com>> 2025 MIT" >> $@
	@echo                                                        >> $@
	@echo "github: https://github.com/ponyatov/$(M)"             >> $@

.PHONY: doxy
doxy: $(D)/.doxygen
$(D)/.doxygen: $(L)
	@echo 'PROJECT_NAME           = "$(M)"'                                     > $@
	@echo 'PROJECT_BRIEF          = "$(D)"'                                    >> $@
	@echo 'PROJECT_LOGO           = doc/logo.png'                              >> $@
	@echo 'OUTPUT_DIRECTORY       = doc'                                       >> $@
	@echo 'HTML_OUTPUT            = html'                                      >> $@
	@echo 'INPUT                  = README.md inc lib src doc hw os cpu arch'  >> $@
	@echo 'INCLUDE_PATH           = inc'                                       >> $@
	@echo 'EXCLUDE                = ref/* *.pdf *.djvu Core Drivers'           >> $@
	@echo 'WARN_IF_UNDOCUMENTED   = NO'                                        >> $@
	@echo 'RECURSIVE              = YES'                                       >> $@
	@echo 'USE_MDFILE_AS_MAINPAGE = README.md'                                 >> $@
	@echo 'GENERATE_LATEX         = NO'                                        >> $@
	@echo 'FILE_PATTERNS         += *.lex *.yacc *.ragel *.rl'                 >> $@
	@echo 'EXTENSION_MAPPING      = lex=C++ yacc=C++ ragel=C++ rl=C++ ino=C++' >> $@
	@echo 'HAVE_DOT               = YES'                                       >> $@
	@echo 'EXTRACT_ALL            = YES'                                       >> $@
	@echo 'EXTRACT_STATIC         = YES'                                       >> $@
	@echo 'EXTRACT_PRIVATE        = YES'                                       >> $@
	@echo 'EXTRACT_PACKAGE        = YES'                                       >> $@
	@echo 'EXTRACT_LOCAL_CLASSES  = YES'                                       >> $@
	@echo 'EXTRACT_LOCAL_METHODS  = YES'                                       >> $@
	@echo 'EXTRACT_ANON_NSPACES   = YES'                                       >> $@
	@echo 'LAYOUT_FILE            = doc/DoxygenLayout.xml'                     >> $@
	@echo 'SORT_GROUP_NAMES       = YES'                                       >> $@
	@echo 'REPEAT_BRIEF           = NO'                                        >> $@
	@echo 'CALL_GRAPH             = YES'                                       >> $@
	@echo 'CALLER_GRAPH           = YES'                                       >> $@

MK  = var version cross dirs tool pkg src cfg all debug clean format rule doc install merge docker
MK_ = $(foreach m,$(MK),$(D)/mk/$(m).mk)

.PHONY: mk
mk: $(D)/Makefile $(MK_)

$(D)/Makefile: $(L)
	echo $(subst $(D)/,"include_",$(MK_)) | tr ' ' '\n' | tr '_' ' ' > $@

$(D)/mk/version.mk: $(L)
	@echo 'CUBEMX_VER = 6.12.1' > $@

.PHONY: docker
docker: $(D)/Dockerfile
$(D)/Dockerfile: $(L)
	@echo 'FROM alpine'                         > $@
	@echo ''                                   >> $@
	@echo 'COPY ./bin              /home/bin/' >> $@
	@echo 'COPY ./etc              /etc/'      >> $@
	@echo 'COPY ./lib              /home/lib/' >> $@
	@echo 'COPY ./tmp/.gitignore   /home/tmp/' >> $@
	@echo ''                                   >> $@
	@echo 'USER    nobody'                     >> $@
	@echo 'WORKDIR /home'                      >> $@
	@echo ''                                   >> $@
	@echo 'CMD ["/bin/sh"]'                    >> $@

.PHONY: doc
doc: $(D)/doc/cli/CLI.md

CMAKE  = $(D)/CMakeLists.txt $(D)/CMakePresets.json
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/cmake/*.cmake))
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/hw/*.cmake))
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/cpu/*.cmake))
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/arch/*.cmake))
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/os/*.cmake))

.PHONY: cmake
cmake: \
		$(D)/CMakeLists.txt $(D)/CMakePresets.json \
		$(D)/cmake/FindRAGEL.cmake $(D)/cmake/any_toolchain.cmake \
		$(D)/cmake/x86_64-linux-gnu.cmake $(D)/cmake/x86_64-linux-musl.cmake \
		$(D)/cmake/mingw-w64-ucrt-x86_64.cmake \
		$(D)/cmake/arm-none-eabi.cmake $(D)/cmake/avr.cmake \
		$(D)/cmake/cross.cmake $(D)/cmake/src.cmake \
		$(D)/cmake/version.cmake $(D)/cmake/syntax.cmake $(D)/cmake/clean.cmake
	touch $(CMAKE)

$(D)/CMakePresets.json: $(L)
	@echo '{'                                                                             > $@
	@echo '    "version": 6,'                                                            >> $@
	@echo '    "buildPresets": ['                                                        >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"           :   "f4disco",'                                  >> $@
	@echo '            "configurePreset":   "f4disco",'                                  >> $@
	@echo '            "targets"        :  ["all","install"]'                            >> $@
	@echo '        },'                                                                   >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"           :   "glibc",'                                    >> $@
	@echo '            "configurePreset":   "glibc",'                                    >> $@
	@echo '            "targets"        :  ["all","install"]'                            >> $@
	@echo '        }'                                                                    >> $@
	@echo '    ],'                                                                       >> $@
	@echo '    "configurePresets": ['                                                    >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"     : "common",'                                           >> $@
	@echo '            "hidden"   :  true,'                                              >> $@
	@echo '            "binaryDir": "$${sourceDir}/tmp/$${presetName}",'                 >> $@
	@echo '            "generator": "Unix Makefiles",'                                   >> $@
	@echo '            "cacheVariables": {'                                              >> $@
	@echo '                "CMAKE_INSTALL_PREFIX"    : "$${sourceDir}/bin",'             >> $@
	@echo '                "CMAKE_MODULE_PATH"       : "$${sourceDir}/cmake",'           >> $@
	@echo '                "CMAKE_COLOR_DIAGNOSTICS" : false,'                           >> $@
	@echo '                "CMAKE_BUILD_TYPE"        : "Debug",'                         >> $@
	@echo '                "CMAKE_VERBOSE_MAKEFILE"  : true'                             >> $@
	@echo '            }'                                                                >> $@
	@echo '        },'                                                                   >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"          :  "cortexM",'                                    >> $@
	@echo '            "hidden"        :   true,'                                        >> $@
	@echo '            "inherits"      :  "common",'                                     >> $@
	@echo '            "toolchainFile" :  "$${sourceDir}/cmake/arm-none-eabi.cmake",'    >> $@
	@echo '            "cacheVariables": {"OS":"bare","CMAKE_EXECUTABLE_SUFFIX":".elf"}' >> $@
	@echo '        },'                                                                   >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"          :  "cortexM0",'                                   >> $@
	@echo '            "hidden"        :   true,'                                        >> $@
	@echo '            "inherits"      :  "cortexM",'                                    >> $@
	@echo '            "cacheVariables": {"ARCH":"cortexM0"}'                            >> $@
	@echo '        },'                                                                   >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"          :  "cortexM3",'                                   >> $@
	@echo '            "hidden"        :   true,'                                        >> $@
	@echo '            "inherits"      :  "cortexM",'                                    >> $@
	@echo '            "cacheVariables": {"ARCH":"cortexM3"}'                            >> $@
	@echo '        },'                                                                   >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"          :  "cortexM4",'                                   >> $@
	@echo '            "hidden"        :   true,'                                        >> $@
	@echo '            "inherits"      :  "cortexM",'                                    >> $@
	@echo '            "cacheVariables": {"ARCH":"cortexM4"}'                            >> $@
	@echo '        },'                                                                   >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"          : "f4disco",'                                     >> $@
	@echo '            "inherits"      : "cortexM4",'                                    >> $@
	@echo '            "cacheVariables": {'                                              >> $@
	@echo '                "HW" :"f4disco",'                                             >> $@
	@echo '                "CPU":"stm32f407vgt", "SERIES": "STM32F4"'                    >> $@
	@echo '            }'                                                                >> $@
	@echo '        },'                                                                   >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"          : "pc",'                                          >> $@
	@echo '            "inherits"      : "common",'                                      >> $@
	@echo '            "hidden"        : true,'                                          >> $@
	@echo '            "cacheVariables": {'                                              >> $@
	@echo '                "HW":"pc", "CPU":"i5", "ARCH":"x86_64"'                       >> $@
	@echo '            }'                                                                >> $@
	@echo '        },'                                                                   >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"          : "linux",'                                       >> $@
	@echo '            "inherits"      : "pc",'                                          >> $@
	@echo '            "hidden"        : true,'                                          >> $@
	@echo '            "cacheVariables": {"OS":"linux"}'                                 >> $@
	@echo '        },'                                                                   >> $@
	@echo '        {'                                                                    >> $@
	@echo '            "name"       : "glibc",'                                          >> $@
	@echo '            "inherits"   : "linux",'                                          >> $@
	@echo '            "displayName": "x86_64-linux-gnu",'                               >> $@
	@echo '            "description": "native host",'                                    >> $@
	@echo '            "toolchainFile": "$${sourceDir}/cmake/x86_64-linux-gnu.cmake"'    >> $@
	@echo '        }'                                                                    >> $@
	@echo '    ]'                                                                        >> $@
	@echo '}'                                                                            >> $@

.PHONY: apt
apt: $(D)/apt.Debian $(D)/apt.Msys
$(D)/apt.Debian: $(L)
	@echo 'git make curl'                     > $@
	@echo 'code meld doxygen clang-format'   >> $@
	@echo 'cmake g++ gdb'                    >> $@
	@echo 'flex bison libreadline-dev ragel' >> $@
	@echo 'python3 python3-venv'             >> $@
	@echo 'dos2unix'                         >> $@
	@echo 'gcc-arm-none-eabi    gdb-multiarch qemu-system-arm' >> $@
	@echo '  newlib-source stlink-tools dfu-util'              >> $@

$(D)/apt.Msys: $(L)
	@echo 'git make curl'                                              > $@
	@echo 'cmake mingw-w64-ucrt-x86_64-gcc mingw-w64-ucrt-x86_64-gdb' >> $@
	@echo 'flex bison libreadline-devel mingw-w64-ucrt-x86_64-ragel'  >> $@
	@echo 'mingw-w64-ucrt-x86_64-clang-tools-extra'                   >> $@

.PHONY: src
src: $(D)/inc/app.hpp $(D)/src/app.lex $(D)/src/app.yacc
	mkdir -p inc src ; touch inc/.gitignore src/.gitignore
	touch src/app.cpp src/app.ragel

$(D)/inc/app.hpp: $(L)
	@echo '#pragma once'                                > $@
	@echo ''                                           >> $@
	@echo '/// @defgroup libc libc' >> $@
	@echo '/// @{' >> $@
	@echo '#include <cstdio>' >> $@
	@echo '#include <cstdlib>' >> $@
	@echo '#include <cassert>' >> $@
	@echo '/// @}' >> $@
	@echo ''                                           >> $@
	@echo '/// @defgroup app app'                      >> $@
	@echo '/// @brief application-specific components' >> $@
	@echo '/// @{'                                     >> $@
	@echo ''                                           >> $@
	@echo ''                                           >> $@
	@echo ''                                           >> $@
	@echo '/// @}'                                     >> $@
	@echo ''                                           >> $@
	@echo '/// @defgroup parser parser' >> $@
	@echo '/// @ingroup cli' >> $@
	@echo '/// @{' >> $@
	@echo 'extern int yylex();' >> $@
	@echo 'extern int yylineno;' >> $@
	@echo 'extern char* yytext;' >> $@
	@echo 'extern char* yyfile;' >> $@
	@echo 'extern FILE* yyin;' >> $@
	@echo 'extern int yyparse();' >> $@
	@echo 'extern void yyerror(const char* msg);' >> $@
	@echo '#include "app.yacc.hpp"' >> $@
	@echo '/// @}' >> $@

$(D)/src/app.lex:  $(L)
	@echo '%{'                         > $@
	@echo '    #include "app.hpp"'    >> $@
	@echo '%}'                        >> $@
	@echo ''                          >> $@
	@echo '%option yylineno noyywrap' >> $@
	@echo '%%'                        >> $@
$(D)/src/app.yacc: $(L)
	@echo '%{'  > $@
	@echo '    #include "app.hpp"' >> $@
	@echo '%}' >> $@
	@echo '' >> $@
	@echo '%defines %union { char c; int n; }' >> $@
	@echo '' >> $@
	@echo '%%'      >> $@
	@echo 'syntax:' >> $@

VSCODE = $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/.vscode/*.json))
.PHONY: vscode
vscode: \
		$(D)/.vscode/c_cpp_properties.json $(D)/.vscode/tasks.json $(D)/.vscode/launch.json \
		$(D)/.vscode/extensions.json $(D)/.vscode/settings.json
	touch $(VSCODE)

$(D)/.vscode/extensions.json: $(L)
	@echo '{' > $@
	@echo '    "recommendations": [' >> $@
	@echo '        "stkb.rewrap",' >> $@
	@echo '        "ryuta46.multi-command",' >> $@
	@echo '        "tabnine.tabnine-vscode",' >> $@
	@echo '        "ms-vscode.makefile-tools",' >> $@
	@echo '        "IBM.output-colorizer",' >> $@
	@echo '        // Linux' >> $@
	@echo '        "ms-vscode-remote.remote-ssh",' >> $@
	@echo '        "ms-azuretools.vscode-docker",' >> $@
	@echo '        "coolbear.systemd-unit-file",' >> $@
	@echo '        // formatters' >> $@
	@echo '        "xaver.clang-format",' >> $@
	@echo '        "foxundermoon.shell-format",' >> $@
	@echo '        "esbenp.prettier-vscode",' >> $@
	@echo '        // misc' >> $@
	@echo '        "usernamehw.errorlens",' >> $@
	@echo '        // "hbenl.vscode-test-explorer",' >> $@
	@echo '        // Web' >> $@
	@echo '        "esbenp.prettier-vscode",' >> $@
	@echo '        "mechatroner.rainbow-csv",' >> $@
	@echo '        // C++' >> $@
	@echo '        "ms-vscode.cpptools",' >> $@
	@echo '        "jeff-hykin.better-cpp-syntax",' >> $@
	@echo '        "ms-vscode.cmake-tools",' >> $@
	@echo '        "twxs.cmake",' >> $@
	@echo '        // parser' >> $@
	@echo '        "daohong-emilio.yash",' >> $@
	@echo '        "rreverser.ragel",' >> $@
	@echo '        // embedded' >> $@
	@echo '        "ms-vscode.hexeditor",' >> $@
	@echo '        "zixuanwang.linkerscript",' >> $@
	@echo '        "dan-c-underwood.arm",' >> $@
	@echo '        // ESP32' >> $@
	@echo '        // "espressif.esp-idf-extension",' >> $@
	@echo '        // Python' >> $@
	@echo '        "ms-python.python",' >> $@
	@echo '        "ms-python.autopep8",' >> $@
	@echo '    ]' >> $@
	@echo '}' >> $@

HW  = pc f4disco l496disco
HWD = $(foreach h,$(HW),$(D)/hw/$(h) $(D)/hw/$(h)/inc $(D)/hw/$(h)/src)
HWI = $(patsubst %,%/.gitignore,$(HWD))
HWF = $(foreach h,$(HW),\
	$(D)/hw/$(h).mk $(D)/hw/$(h).cmake \
	$(D)/hw/$(h)/inc/$(h).hpp $(D)/hw/$(h)/src/$(h).cpp \
	$(D)/hw/$(h)/$(h).ioc)

.PHONY: hw
hw:
	mkdir -p $(HWD) ; touch $(HWI) $(HWF)

LIB  = core cli
LIBD = $(foreach l,$(LIB),$(D)/lib/$(l) $(D)/lib/$(l)/inc $(D)/lib/$(l)/src)
LIBI = $(patsubst %,%/.gitignore,$(LIBD))
LIBF = $(foreach l,$(LIB),\
	$(D)/lib/$(l)/inc/$(l).hpp $(D)/lib/$(l)/src/$(l).cpp \
	)

.PHONY: lib
lib: $(CLI)
	mkdir -p $(LIBD) ; touch $(LIBI) $(LIBF)
	$(MAKE) -f $(L) -C $(D) M=$(M) cli

CLI = $(wildcard $(T)/lib/cli/src/*.ragel)

.PHONY: cli
cli: $(CLI)

.PHONY: ls
ls:
	ls -la .
