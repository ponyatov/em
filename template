#!/usr/bin/make -f

M ?= $(notdir  $(CURDIR)       )
D  = $(abspath $(HOME)/$(M)    )
L  = $(abspath $(MAKEFILE_LIST))
T  = $(abspath $(dir $(L))     )

.PHONY: template
template:
# mkdir -p $(D)
# $(MAKE) -f $(L) -C $(D) M=$(M) git dirs giti files doc cmake mk
# $(MAKE) -f $(L) -C $(D) M=$(M) dirs giti
	$(MAKE) -f $(L) -C $(D) M=$(M) giti files mk

.PHONY: git
git: .git
.git:
	git init
	git remote add gh    git@github.com:ponyatov/$(M).git
	git remote add flic git@gitflic.ru:dponyatov/$(M).git
#
	git checkout --orphan dev
	ln -fs ../rc rc ; git add rc ; git commit -am "."
	git push -v -u gh dev
#
	git checkout --orphan `whoami`
	ln -fs ../rc rc ; git add rc ; git commit -am "."
	git push -v -u gh   `whoami`
	git push       flic `whoami`

DIRS  = $(shell find $(T)/* -maxdepth 0 -type d)
DIRS += $(shell find $(T)/doc/* -maxdepth 1 -type d)
DIRS := $(patsubst $(T)/%,$(D)/%,$(DIRS))

.PHONY: dirs
dirs:
	mkdir -p $(DIRS)

GITI = $(patsubst %,%/.gitignore,$(DIRS))

.PHONY: giti
giti:
	touch $(GITI)
	@echo '*~'           > $(D)/.gitignore
	@echo '*.swp'       >> $(D)/.gitignore
	@echo '*.log'       >> $(D)/.gitignore
	@echo '!.gitignore' >> $(D)/.gitignore
	@echo 'html/'        > $(D)/doc/.gitignore
	@echo '*'            > $(D)/bin/.gitignore
	@echo '*'            > $(D)/ref/.gitignore
	@echo '*'            > $(D)/tmp/.gitignore

.PHONY: files
files: \
		$(D)/.clang-format $(D)/README.md $(D)/.doxygen $(D)/LICENSE \
		$(D)/.gitattributes $(D)/.prettierrc $(D)/Dockerfile \
		$(D)/doc/DoxygenLayout.xml $(D)/doc/logo.png
	touch \
		$(D)/apt.Debian $(D)/apt.Msys

$(D)/%: $(T)/% $(L)
	cp $< $@

.PHONY: readme
readme: $(D)/README.md
$(D)/README.md: $(L)
	@echo "# \`$(M)\`"                                            > $@
	@echo "## $(D)"                                              >> $@
	@echo                                                        >> $@
	@echo "(c) Dmitry Ponyatov <<dponyatov@gmail.com>> 2025 MIT" >> $@
	@echo                                                        >> $@
	@echo "github: https://github.com/ponyatov/$(M)"             >> $@

.PHONY: doxy
doxy: $(D)/.doxygen
$(D)/.doxygen: $(L)
	@echo 'PROJECT_NAME           = "$(M)"'                                     > $@
	@echo 'PROJECT_BRIEF          = "$(D)"'                                    >> $@
	@echo 'PROJECT_LOGO           = doc/logo.png'                              >> $@
	@echo 'OUTPUT_DIRECTORY       = doc'                                       >> $@
	@echo 'HTML_OUTPUT            = html'                                      >> $@
	@echo 'INPUT                  = README.md inc lib src doc hw os cpu arch'  >> $@
	@echo 'INCLUDE_PATH           = inc'                                       >> $@
	@echo 'EXCLUDE                = ref/* *.pdf *.djvu Core Drivers'           >> $@
	@echo 'WARN_IF_UNDOCUMENTED   = NO'                                        >> $@
	@echo 'RECURSIVE              = YES'                                       >> $@
	@echo 'USE_MDFILE_AS_MAINPAGE = README.md'                                 >> $@
	@echo 'GENERATE_LATEX         = NO'                                        >> $@
	@echo 'FILE_PATTERNS         += *.lex *.yacc *.ragel *.rl'                 >> $@
	@echo 'EXTENSION_MAPPING      = lex=C++ yacc=C++ ragel=C++ rl=C++ ino=C++' >> $@
	@echo 'HAVE_DOT               = YES'                                       >> $@
	@echo 'EXTRACT_ALL            = YES'                                       >> $@
	@echo 'EXTRACT_STATIC         = YES'                                       >> $@
	@echo 'EXTRACT_PRIVATE        = YES'                                       >> $@
	@echo 'EXTRACT_PACKAGE        = YES'                                       >> $@
	@echo 'EXTRACT_LOCAL_CLASSES  = YES'                                       >> $@
	@echo 'EXTRACT_LOCAL_METHODS  = YES'                                       >> $@
	@echo 'EXTRACT_ANON_NSPACES   = YES'                                       >> $@
	@echo 'LAYOUT_FILE            = doc/DoxygenLayout.xml'                     >> $@
	@echo 'SORT_GROUP_NAMES       = YES'                                       >> $@
	@echo 'REPEAT_BRIEF           = NO'                                        >> $@
	@echo 'CALL_GRAPH             = YES'                                       >> $@
	@echo 'CALLER_GRAPH           = YES'                                       >> $@

.PHONY: mk
mk: $(D)/Makefile

$(D)/Makefile: $(L)
	@echo 'include mk/var.mk'      > $@
	@echo 'include mk/version.mk' >> $@
	@echo 'include mk/cross.mk'   >> $@
	@echo 'include mk/dirs.mk'    >> $@
	@echo 'include mk/tool.mk'    >> $@
	@echo 'include mk/src.mk'     >> $@
	@echo 'include mk/cfg.mk'     >> $@
	@echo 'include mk/all.mk'     >> $@
	@echo 'include mk/clean.mk'   >> $@
	@echo 'include mk/format.mk'  >> $@
	@echo 'include mk/debug.mk'   >> $@
	@echo 'include mk/rule.mk'    >> $@
	@echo 'include mk/doc.mk'     >> $@
	@echo 'include mk/install.mk' >> $@
	@echo 'include mk/merge.mk'   >> $@
	@echo 'include mk/docker.mk'  >> $@

.PHONY: docker
docker: $(D)/Dockerfile
$(D)/Dockerfile: $(L)
	@echo 'FROM alpine'                         > $@
	@echo ''                                   >> $@
	@echo 'COPY ./bin              /home/bin/' >> $@
	@echo 'COPY ./etc              /etc/'      >> $@
	@echo 'COPY ./lib              /home/lib/' >> $@
	@echo 'COPY ./tmp/.gitignore   /home/tmp/' >> $@
	@echo ''                                   >> $@
	@echo 'USER    nobody'                     >> $@
	@echo 'WORKDIR /home'                      >> $@
	@echo ''                                   >> $@
	@echo 'CMD ["/bin/sh"]'                    >> $@

.PHONY: doc
doc: $(D)/doc/cli/CLI.md

CMAKE  = $(D)/CMakeLists.txt $(D)/CMakePresets.json
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/cmake/*.cmake))
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/hw/*.cmake))
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/cpu/*.cmake))
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/arch/*.cmake))
CMAKE += $(patsubst $(T)/%,$(D)/%,$(wildcard $(T)/os/*.cmake))

.PHONY: cmake
cmake: \
		$(D)/CMakeLists.txt $(D)/CMakePresets.json \
		$(D)/cmake/FindRAGEL.cmake $(D)/cmake/any_toolchain.cmake
	touch $(CMAKE)

$(D)/CMakePresets.json: $(L)
	echo '{'                                                                             > $@
	echo '    "version": 6,'                                                            >> $@
	echo '    "buildPresets": ['                                                        >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"           :   "glibc",'                                    >> $@
	echo '            "configurePreset":   "glibc",'                                    >> $@
	echo '            "targets"        :  ["all","install"]'                            >> $@
	echo '        },'                                                                   >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"           :   "f4disco",'                                  >> $@
	echo '            "configurePreset":   "f4disco",'                                  >> $@
	echo '            "targets"        :  ["all","install"]'                            >> $@
	echo '        },'                                                                   >> $@
	echo '    ],'                                                                       >> $@
	echo '    "configurePresets": ['                                                    >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"     : "common",'                                           >> $@
	echo '            "hidden"   :  true,'                                              >> $@
	echo '            "binaryDir": "$${sourceDir}/tmp/$${presetName}",'                 >> $@
	echo '            "generator": "Unix Makefiles",'                                   >> $@
	echo '            "cacheVariables": {'                                              >> $@
	echo '                "CMAKE_INSTALL_PREFIX"    : "$${sourceDir}/bin",'             >> $@
	echo '                "CMAKE_MODULE_PATH"       : "$${sourceDir}/cmake",'           >> $@
	echo '                "CMAKE_COLOR_DIAGNOSTICS" : false,'                           >> $@
	echo '                "CMAKE_BUILD_TYPE"        : "Debug",'                         >> $@
	echo '                "CMAKE_VERBOSE_MAKEFILE"  : true'                             >> $@
	echo '            }'                                                                >> $@
	echo '        },'                                                                   >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"          : "pc",'                                          >> $@
	echo '            "inherits"      : "common",'                                      >> $@
	echo '            "hidden"        : true,'                                          >> $@
	echo '            "cacheVariables": {'                                              >> $@
	echo '                "HW":"pc", "CPU":"i5", "ARCH":"x86_64"'                       >> $@
	echo '            }'                                                                >> $@
	echo '        },'                                                                   >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"          : "linux",'                                       >> $@
	echo '            "inherits"      : "pc",'                                          >> $@
	echo '            "hidden"        : true,'                                          >> $@
	echo '            "cacheVariables": {"OS":"linux"}'                                 >> $@
	echo '        },'                                                                   >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"       : "glibc",'                                          >> $@
	echo '            "inherits"   : "linux",'                                          >> $@
	echo '            "displayName": "x86_64-linux-gnu",'                               >> $@
	echo '            "description": "native host",'                                    >> $@
	echo '            "toolchainFile": "$${sourceDir}/cmake/x86_64-linux-gnu.cmake"'    >> $@
	echo '        },'                                                                   >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"          :  "cortexM",'                                    >> $@
	echo '            "hidden"        :   true,'                                        >> $@
	echo '            "inherits"      :  "common",'                                     >> $@
	echo '            "toolchainFile" :  "$${sourceDir}/cmake/arm-none-eabi.cmake",'    >> $@
	echo '            "cacheVariables": {"OS":"bare","CMAKE_EXECUTABLE_SUFFIX":".elf"}' >> $@
	echo '        },'                                                                   >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"          :  "cortexM0",'                                   >> $@
	echo '            "hidden"        :   true,'                                        >> $@
	echo '            "inherits"      :  "cortexM",'                                    >> $@
	echo '            "cacheVariables": {"ARCH":"cortexM0"}'                            >> $@
	echo '        },'                                                                   >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"          :  "cortexM3",'                                   >> $@
	echo '            "hidden"        :   true,'                                        >> $@
	echo '            "inherits"      :  "cortexM",'                                    >> $@
	echo '            "cacheVariables": {"ARCH":"cortexM3"}'                            >> $@
	echo '        },'                                                                   >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"          :  "cortexM4",'                                   >> $@
	echo '            "hidden"        :   true,'                                        >> $@
	echo '            "inherits"      :  "cortexM",'                                    >> $@
	echo '            "cacheVariables": {"ARCH":"cortexM4"}'                            >> $@
	echo '        },'                                                                   >> $@
	echo '        {'                                                                    >> $@
	echo '            "name"          : "f4disco",'                                     >> $@
	echo '            "inherits"      : "cortexM4",'                                    >> $@
	echo '            "cacheVariables": {'                                              >> $@
	echo '                "HW" :"f4disco",'                                             >> $@
	echo '                "CPU":"stm32f407vgt", "SERIES": "STM32F4"'                    >> $@
	echo '            }'                                                                >> $@
	echo '        },'                                                                   >> $@
	echo '    ]'                                                                        >> $@
	echo '}'                                                                            >> $@
