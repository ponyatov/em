# ln -fs ~/prectimer/.unison ~/.unison/prectimer.prf
# ls -la ~/.unison/prectimer*
# unison prectimer

# Название профиля (опционально)
label = prectimer sync

# Корневые директории
root = /home/dponyatov/prectimer
root = ssh://dev01@10.110.1.106//home/dev01/prectimer

# Автоматизация
auto   = true
batch  = true
prefer = newer

# Игнорирование специфичных файлов и кэшей
# ignore = Name {.unison}
ignore = Name {g?d,sender}
ignore = Name {.git}
ignore = Name {*~,*.log,*.sw?}
ignore = Name {bin,tmp,ref}
ignore = Name {doc/html,lib/pcpp}
ignore = Name {node_modules,.cache}
ignore = Name {*.pyc,__pycache__}
