set pagination off
set confirm off
set print pretty on
set sysroot /
set trust-readonly-sections on

# target remote :12345
# set solib-absolute-prefix /
# set solib-search-path /usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:/usr/lib64:/lib64
# info inferiors
# info sharedlibrary

break main
continue
