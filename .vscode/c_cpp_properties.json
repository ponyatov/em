{
    "version": 4,
    "env":{
        "appInclude": [
            "${workspaceFolder}/inc/**",
            "${workspaceFolder}/tmp/**",
            "${workspaceFolder}/src/**"
        ],
        "crossInclude": [
            "${workspaceFolder}/hw/inc/**",
            "${workspaceFolder}/cpu/inc/**",
            "${workspaceFolder}/arch/inc/**",
            "${workspaceFolder}/os/inc/**"
        ],
        "libInclude": [
            "${workspaceFolder}/lib/led/inc/**",
            "${workspaceFolder}/lib/core/inc/**"
        ]
    },
    "configurations": [
        {
            "name"                 : "cmake",
            "configurationProvider": "ms-vscode.cmake-tools",
            "mergeConfigurations"  :  true,
            "includePath": [
                "${appInclude}", "${crossInclude}", "${libInclude}"
            ],
            "defines": [
                "F4DISCO"  , "STM32F407xx", "STM32F4",
                "L496DISCO", "STM32L496xx", "STM32L4",
                "ISKRAJS"  , "STM32F405xx", "STM32F4",
                "__FPU_PRESENT", "__FPU_USED",
                "HAVE_INITFINI_ARRAY", "HAVE_INIT_FINI"
            ]
        }
    ]
}
