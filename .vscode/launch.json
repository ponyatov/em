{
    "version": "0.2.0",
    "configurations": [
        {
            "name"         : "Extension",
            "type"         : "extensionHost",
            "request"      : "launch",
            "args"         : ["--extensionDevelopmentPath=${workspaceFolder}"]
        },
        {
            "type"   : "lldb",
            "request": "launch",
            "name"   : "rust:linux",
            "program": "target/debug/${workspaceFolderBasename}",
            "args"   : ["lib/${workspaceFolderBasename}.ini"],
            "cwd"    : "${workspaceFolder}",
            "cargo"  : {"args": ["build"]}
            // "--bin=${workspaceFolderBasename}",
            // "--package=${workspaceFolderBasename}",
            // "--target=x86_64-unknown-linux-gnu",
            // "--features=pc"
            // "filter": {"name": "main","kind": "bin"}
            // "stopOnEntry"   : true,
            // "preLaunchTask" : "cargo: build",
            // "preRunCommands": [ "process launch --stop-at-entry" ]
        },
        {
            "name"              : "pillf103",
            "type"              : "cortex-debug",
            "request"           : "launch",
            "executable"        : "target/thumbv7m-none-eabi/debug/em",
            "cwd"               : "${workspaceFolder}",
            "servertype"        : "qemu",
            "machine"           : "netduino2",
            "cpu"               : "cortex-m3",
            // "gdbTarget": ":12345",
            "preLaunchTask"     : "cargo: pillf103",
            "gdbPath"           : "gdb-multiarch",
            // "runToEntryPoint"   : "DefaultPreInit",
            "runToEntryPoint"   : "main",
            // "preRestartCommands": [
            //     "load",
            //     // "break DefaultPreInit",
            //     "break Reset",
            //     "break ResetHandler",
            //     "break DefaultHandler",
            // ]
        },
        {
            "name"          : "cmake:cortex",
            "type"          : "cppdbg",
            "request"       : "launch",
            "program"       : "${command:cmake.launchTargetPath}",
            "preLaunchTask" : "CMake: build",
            "cwd"           : "${workspaceFolder}",
            "MIMode"        : "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerArgs": "--silent",
            "miDebuggerServerAddress": "localhost:3333",
            "useExtendedRemote": true,
            "setupCommands": [
                {"text": "-enable-pretty-printing", "ignoreFailures": true}
            ],
            "stopAtEntry": false, // don't enable!
            "postRemoteConnectCommands": [
                {"text": "monitor reset halt"},
                {"text": "load"},
                {"text": "set substitute-path /home/pere/src/newlib-salsa ${userHome}/cross/src/newlib-salsa"},
                // {"text": "b Reset_Handler"},
                {"text": "b DefaultHandler"},
                // {"text": "b SystemInit"},
                // {"text": "b __libc_init_array"},
                {"text": "b main"},
                // {"text": "b MX_GPIO_Init"},
                // {"text": "b sbrk"}, {"text": "b _sbrk"},
                // {"text": "b jsvObjectSetChild"},
                {"text": "monitor reset halt"}, // req
            ],
        },
        {
            "name"            : "cmake:linux",
            "type"            : "cppdbg",
            "request"         : "launch",
            "cwd"             : "${workspaceFolder}",
            "program"         : "${command:cmake.launchTargetPath}",
            "args"            : ["lib/${workspaceFolderBasename}.ini"],
            "environment"     : [],
            "preLaunchTask"   : "CMake: build",
            "stopAtEntry"     : true,
            "externalConsole" : false,
            "MIMode"          : "gdb",
            "miDebuggerPath"  : "gdb",
            "setupCommands"   : [
                {"text": "-enable-pretty-printing","ignoreFailures": true},
                {"text": "source ${workspaceFolder}/.gdbinit","ignoreFailures": true}
            ]
        },
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "Launch",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug",
            "chip": "esp32s3",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true,
                "verifyBeforeFlashing": true,
                "formatOptions": {
                    "binaryFormat": "idf"
                }
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "target/xtensa-esp32s3-none-elf/debug/${workspaceFolderBasename}",
                    "rttEnabled": true,
                }
            ]
        },
        {
            "type": "probe-rs-debug",
            "request": "attach",
            "name": "Attach",
            "cwd": "${workspaceFolder}",
            "chip": "esp32s3",
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "target/xtensa-esp32s3-none-elf/debug/${workspaceFolderBasename}",
                    "rttEnabled": true,
                }
            ]
        }
    ]
}
