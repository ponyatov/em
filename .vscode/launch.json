{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "rust:linux",
            "cargo": {
                "args": [
                    "build",
                    "--features=pc",
                    "--target=x86_64-unknown-linux-gnu",
                    "--bin=${workspaceFolderBasename}",
                    "--package=${workspaceFolderBasename}"
                ]
            },
            "args": ["1024", "768"],
            "cwd": "${workspaceFolder}",
            // "stopOnEntry": true,
            "preLaunchTask": "cargo: build",
            "preRunCommands": [
                "process launch --stop-at-entry"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "rust:tests",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=${workspaceFolderBasename}"
                ],
                "filter": {
                    "name": "${workspaceFolderBasename}",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name"              : "pillf103",
            "type"              : "cortex-debug",
            "request"           : "launch",
            "executable"        : "target/thumbv7m-none-eabi/debug/em",
            "cwd"               : "${workspaceFolder}",
            "servertype"        : "qemu",
            "machine"           : "netduino2",
            "cpu"               : "cortex-m3",
            // "gdbTarget": ":12345",
            "preLaunchTask"     : "cargo: pillf103",
            "gdbPath"           : "gdb-multiarch",
            // "runToEntryPoint"   : "DefaultPreInit",
            "runToEntryPoint"   : "main",
            // "preRestartCommands": [
            //     "load",
            //     // "break DefaultPreInit",
            //     "break Reset",
            //     "break ResetHandler",
            //     "break DefaultHandler",
            // ]
        },
        {
            "name"          : "cortex",
            "type"          : "cppdbg",
            "request"       : "launch",
            "program"       : "${command:cmake.launchTargetPath}",
            "preLaunchTask" : "CMake: build",
            "cwd"           : "${workspaceFolder}",
            "MIMode"        : "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerArgs": "--silent",
            "miDebuggerServerAddress": "localhost:12345",
            "useExtendedRemote": true,
            "setupCommands": [
                {"text": "-enable-pretty-printing", "ignoreFailures": true}
            ],
            "stopAtEntry": false, // don't enable!
            "postRemoteConnectCommands": [
                {"text": "monitor reset halt"},
                {"text": "load"},
                {"text": "set substitute-path /home/pere/src/newlib-salsa ${userHome}/em/ref/newlib-salsa"},
                // {"text": "b Reset_Handler"},
                // {"text": "b DefaultHandler"},
                // {"text": "b SystemInit"},
                // {"text": "b __libc_init_array"},
                // {"text": "b main"},
                // {"text": "b MX_GPIO_Init"},
                // {"text": "b sbrk"}, {"text": "b _sbrk"},
                // {"text": "b jsvObjectSetChild"},
                {"text": "monitor reset halt"}, // req
            ],
        },
        {
            "name"         : "cmake:linux",
            "type"         : "cppdbg",
            "request"      : "launch",
            "program"      : "${command:cmake.launchTargetPath}",
            "preLaunchTask": "CMake: build",
            "cwd"          : "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [
                {"text": "-enable-pretty-printing", "ignoreFailures": true}
            ],
            "args": ["${workspaceFolder}/lib/${workspaceFolderBasename}.ini"],
            "externalConsole": false,
            "stopAtEntry": true,
        }
    ]
}
