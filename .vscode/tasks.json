{
    "version": "2.0.0",
    "tasks": [
        {
            "label"          : "project: install",
            "type"           : "shell",
            "command"        : "make install",
            "presentation"   : {"focus": true},
            "problemMatcher" : []
        },
        {
            "label"          : "project: update",
            "type"           : "shell",
            "command"        : "make update",
            "presentation"   : {"focus": true},
            "problemMatcher" : []
        },
        {
            "label"          : "git: whoami",
            "type"           : "shell",
            "command"        : "make `whoami`",
            "problemMatcher" : []
        },
        {
            "label"          : "git: dev",
            "type"           : "shell",
            "command"        : "make dev",
            "problemMatcher" : []
        },
        {
            "label"          : "git: checkout .vscode",
            "type"           : "shell",
            "command"        : "git checkout .vscode/settings.json",
            "problemMatcher" : []
        },
        {
            "label"          : "debug: openocd",
            "type"           : "shell",
            "group"          : {"kind": "build", "isDefault": true},
            "dependsOn"      : "CMake: build",
            "command"        : "openocd -f ${workspaceFolder}/hw/${command:cmake.activeConfigurePresetName}/${command:cmake.activeConfigurePresetName}.ocd -c \"program ${command:cmake.launchTargetPath} verify reset\"",
            "problemMatcher" : [],
            "presentation"   : {"showReuseMessage": false, "focus": false, "reveal": "silent", "close": true}
        },
        {
            "label"          : "openocd: firmware",
            "type"           : "shell",
            "group"          : {"kind": "build", "isDefault": true },
            "dependsOn"      : "CMake: build",
            "command"        : "openocd -f ${workspaceFolder}/hw/${command:cmake.activeConfigurePresetName}/${command:cmake.activeConfigurePresetName}.ocd -c \"program ${command:cmake.launchTargetPath} verify reset exit \"",
            "problemMatcher" : [],
            "presentation"   : {
                "showReuseMessage": false, "focus": true, "close": false
            }
        },
        {
            "label"          : "python: run",
            "type"           : "shell",
            "command"        : "python3 ${file}",
            "problemMatcher" : [],
            "presentation"   : {"showReuseMessage": false, "focus": false, "reveal": "silent"},
            "group"          : {"kind": "build","isDefault": true}
        },
        {
            "type"           : "cmake",
            "label"          : "cmake: build",
            "command"        : "build",
            "targets"        : ["all"],
            "preset"         : "${command:cmake.activeBuildPresetName}",
            "group"          : "build",
            "problemMatcher" : [],
            "promptOnClose"  : false
        },
        {
            "label"          :  "cargo: fortex",
            "type"           :  "shell",
            "command"        :  "cargo",
            "args"           : ["build", "--target", "thumbv7m-none-eabi"],
            "options"        : {"cwd": "${workspaceFolder}/fortex"},
            "problemMatcher" : ["$rustc"],
            "presentation"   : {"showReuseMessage": false, "focus": true, "reveal": "silent"},
            "group"          : {"kind": "build", "isDefault": true}
        },
        {
            "label"          : "zig: build",
            "type"           : "shell",
            "command"        : "zig build",
            "presentation"   : {"focus": true},
            "problemMatcher" : [],
            "group"          : { "kind": "build", "isDefault": true }

        },
    ]
}
