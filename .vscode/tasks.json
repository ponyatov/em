{
    "version": "2.0.0",
    "tasks": [
        {
            "label"          : "project: install",
            "type"           : "shell",
            "command"        : "make install",
            "presentation"   : {"focus": true},
            "problemMatcher" : []
        },
        {
            "label"          : "project: update",
            "type"           : "shell",
            "command"        : "make update",
            "presentation"   : {"focus": true},
            "problemMatcher" : []
        },
        {
            "label"          : "git: whoami",
            "type"           : "shell",
            "command"        : "make `whoami`",
            "problemMatcher" : []
        },
        {
            "label"          : "git: dev",
            "type"           : "shell",
            "command"        : "make dev",
            "problemMatcher" : []
        },
        {
            "label"          : "git: checkout .vscode",
            "type"           : "shell",
            "command"        : "git checkout .vscode/settings.json",
            "presentation"   : {"showReuseMessage": false, "focus": false, "reveal": "silent", "close": true},
            "problemMatcher" : []
        },
        {
            "type"           : "cmake",
            "label"          : "cmake: build",
            "command"        : "build",
            "targets"        : ["all"],
            "preset"         : "${command:cmake.activeBuildPresetName}",
            "group"          : "build",
            "problemMatcher" : [],
            "promptOnClose"  : false
        },
        {
            "label"          : "openocd: debug",
            "type"           : "shell",
            "dependsOn"      : "CMake: build",
            "command"        : "openocd -f hw/${command:cmake.activeConfigurePresetName}/${command:cmake.activeConfigurePresetName}.ocd",
            "problemMatcher" : [],
            "presentation"   : {"showReuseMessage": false, "focus": false, "reveal": "silent", "close": true}
        },
        {
            "label"          : "openocd: firmware",
            "type"           : "shell",
            "dependsOn"      : "CMake: build",
            "command"        : "openocd -f hw/${command:cmake.activeConfigurePresetName}/${command:cmake.activeConfigurePresetName}.ocd -c \"program ${command:cmake.launchTargetPath} verify reset exit\"",
            "problemMatcher" : [],
            "presentation"   : {"showReuseMessage": false, "focus": true, "reveal": "silent", "close": false}
        },
        {
            "label"          : "python: run",
            "type"           : "shell",
            "command"        : "python3 ${file}",
            "problemMatcher" : [],
            "presentation"   : {"showReuseMessage": false, "focus": false, "reveal": "silent"},
            "group"          : {"kind": "build","isDefault": true}
        },
        {
            "label"          :  "cargo: build",
            "type"           :  "shell",
            "command"        :  "cargo",
            "args"           : ["build"], //"--target", "thumbv7em-none-eabihf"],
            "options"        : {"cwd": "${workspaceFolder}"},
            "problemMatcher" : ["$rustc"],
            "presentation"   : {"showReuseMessage": false, "focus": true, "reveal": "silent"},
            "group"          : {"kind": "build", "isDefault": true}
        },
        {
            "label"          :  "cargo: blink (M3)",
            "type"           :  "shell",
            "command"        :  "cargo",
            "args"           : ["run","-p","blink", "--target", "thumbv7m-none-eabi"],
            "options"        : {"cwd": "${workspaceFolder}"},
            "problemMatcher" : ["$rustc"],
            "presentation"   : {"showReuseMessage": false, "focus": true, "reveal": "silent"},
            "group"          : {"kind": "build", "isDefault": true}
        },
        {
            "label"          :  "cargo: blink (M4)",
            "type"           :  "shell",
            "command"        :  "cargo",
            "args"           : ["run","-p","blink", "--target", "thumbv7em-none-eabihf"],
            "options"        : {"cwd": "${workspaceFolder}"},
            "problemMatcher" : ["$rustc"],
            "presentation"   : {"showReuseMessage": false, "focus": true, "reveal": "silent"},
            "group"          : {"kind": "build", "isDefault": true}
        },
        {
            "label"          : "zig: build",
            "type"           : "shell",
            "command"        : "zig build",
            "presentation"   : {"focus": true},
            "problemMatcher" : [],
            "group"          : { "kind": "build", "isDefault": true }
        },
    ]
}
