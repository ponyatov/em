{
    "comments": {
        "lineComment": "#!"
        "lineComment": "//",
        "blockComment": [ "/*", "*/" ]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoCloseBefore": ";:.,=}])> \n\t",
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        { "open": "\"", "close": "\"",
            "notIn": [ "string" ]
        },
        { "open": "'", "close": "'",
            "notIn": [ "string", "comment" ]
        }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        [ "\"", "\"" ],
        [ "'" , "'"  ]
    ]
}
