{
    "name"        : "bcx",
    "displayName" : "bcx: ByteCode eXecutor",
    "description" : "script language VM for embedded systems",
    "version"     : "0.0.1",
    "icon"        : "./logo.png",
    "publisher"   : "dponyatov",
    "license"     : "MIT",
    "homepage"    : "https://github.com/ponyatov/bcx",
    "author": {
        "name": "Dmitry Ponyatov", "email": "dponyatov@gmail.com"
    },
    "bugs": {
        "url": "https://github.com/ponyatov/bcx/issue"
    },
    "repository": {
        "type": "git", "url" : "https://github.com/ponyatov/bcx/tree/dponyatov/vscode"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages", "Debuggers"
    ],
    "keywords": [
        "bcx", "bytecode", "VM",
        "FORTH","CLI", "REPL",
        "embedded", "MCU", "STM32", "ESP32"
    ],
    "activationEvents": [
        "onLanguage:bcx",
        "onDebugResolve:bcx",
        "onDebugDynamicConfigurations:bcx",
        "workspaceContains:lib/*.ini",
        "workspaceContains:lib/*.?"
    ],
    "extensionDependencies": [
        "ms-vscode.cpptools",
        "jeff-hykin.better-cpp-syntax",
        "ms-vscode.cmake-tools",
        "daohong-emilio.yash",
        "rreverser.ragel",
        "zixuanwang.linkerscript",
        "ms-vscode.vscode-serial-monitor"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "bcx",
                "aliases": [
                    "bcx",
                    "ByteCode eXecutor"
                ],
                "extensions": [
                    ".bcx",
                    ".ini",
                    ".f"
                ],
                "configuration": "./languageConfiguration.json"
            }
        ],
        "grammars": [
            {
                "language": "bcx",
                "scopeName": "source.bcx",
                "path": "./tmLanguage.json"
            }
        ],
    }
}
