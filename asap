	@echo '                "HW":"pc", "CPU":"i5", "ARCH":"x86_64"' >> $@
	@echo '            }' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"          : "linux",' >> $@
	@echo '            "inherits"      : "pc",' >> $@
	@echo '            "hidden"        : true,' >> $@
	@echo '            "cacheVariables": {"OS":"linux"}' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"         : "glibc",' >> $@
	@echo '            "inherits"     : "linux",' >> $@
	@echo '            "displayName"  : "x86_64-linux-gnu",' >> $@
	@echo '            "description"  : "native host",' >> $@
	@echo '            "toolchainFile": "$${sourceDir}/cmake/x86_64-linux-gnu.cmake"' >> $@
	@echo '        }' >> $@
	@echo '   ]' >> $@
	@echo '}' >> $@

HWA = pillF103
HWX = $(foreach m,$(HWA),hw/$(m)/$(m).ioc)
HW  = pc $(HWA)
HWD = $(foreach d,$(HW),hw/$(d) hw/$(d)/inc hw/$(d)/src)
HWI = $(patsubst %,%/.gitignore,$(HWD))
HWC = $(foreach d,$(HW),hw/$(d)/inc/$(d).hpp hw/$(d)/src/$(d).cpp)
HWM = $(foreach m,$(HW),hw/$(m)/$(m).mk hw/$(m)/$(m).cmake)

.PHONY: hw
hw: $(HWD) $(HWI) $(HWC) $(HWM) $(HWX) $(HWL)
$(HWD):
	mkdir -p $@
$(HWC):
	touch $@
hw/%: $(S)/hw/% $(T)
	cp $< $@
hw/%.ioc: $(S)/hw/%.ioc $(T)
	echo -n > $@

CPU  = i5 stm32f103c8t
# stm32f407vgt stm32f405rgt stm32l496agi
CPUD = $(foreach d,$(CPU),cpu/$(d) cpu/$(d)/inc cpu/$(d)/src)
CPUI = $(patsubst %,%/.gitignore,$(CPUD))
CPUC = $(foreach d,$(CPU),cpu/$(d)/inc/$(d).hpp cpu/$(d)/src/$(d).cpp)
CPUM = $(foreach m,$(CPU),cpu/$(m)/$(m).mk cpu/$(m)/$(m).cmake)

.PHONY: cpu
cpu: $(CPUD) $(CPUI) $(CPUC) $(CPUM)
$(CPUD):
	mkdir -p $@
$(CPUC) $(CPUM): $(T)
	$(foreach i,$@,cp $(S)/$(i) $(i))

ARCH  = x86_64 cortexM cortexM3
ARCHD = $(foreach d,$(ARCH),arch/$(d) arch/$(d)/inc arch/$(d)/src)
ARCHI = $(patsubst %,%/.gitignore,$(ARCHD))
ARCHC = $(foreach d,$(ARCH),arch/$(d)/inc/$(d).hpp arch/$(d)/src/$(d).cpp)
ARCHM = $(foreach m,$(ARCH),arch/$(m)/$(m).mk arch/$(m)/$(m).cmake)

.PHONY: arch
arch: $(ARCHD) $(ARCHI) $(ARCHC) $(ARCHM)
$(ARCHD):
	mkdir -p $@
$(ARCHM) $(ARCHC): $(T)
	$(foreach i,$@,cp $(S)/$(i) $(i))
	
OS   = bare linux
OSD  = $(foreach d,$(OS),os/$(d) os/$(d)/inc os/$(d)/src)
OSI  = $(patsubst %,%/.gitignore,$(OSD))
OSC  = $(foreach d,$(OS),os/$(d)/inc/$(d).hpp os/$(d)/src/$(d).cpp)
OSC += $(foreach s,os main,os/inc/$(s).hpp os/src/$(s).cpp)
OSM  = $(foreach m,$(OS),os/$(m)/$(m).mk os/$(m)/$(m).cmake)

.PHONY: os
os: $(OSD) $(OSI) $(OSC) $(OSM)
$(OSD):
	mkdir -p $@
$(OSC) $(OSM): $(T)
	$(foreach i,$@,cp $(S)/$(i) $(i))

LIB = cli core
LIBD = $(foreach d,$(LIB),lib/$(d) lib/$(d)/inc lib/$(d)/src)
LIBI = $(patsubst %,%/.gitignore,$(LIBD))
LIBC = $(foreach d,$(LIB),lib/$(d)/inc/$(d).hpp lib/$(d)/src/$(d).cpp)
LIBR = lib/cli/cli.ragel

.PHONY: lib
lib: $(LIBD) $(LIBI) $(LIBC) $(LIBR)
$(LIBD):
	mkdir -p $@
$(LIBC) $(LIBR):
	touch $@

# any non-existent file
%:
	touch $@
src/%:
	touch $@
