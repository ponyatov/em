	@echo '        {' >> $@
	@echo '            "name"          : "pillF103",' >> $@
	@echo '            "inherits"      : "cortexM3",' >> $@
	@echo '            "cacheVariables": {' >> $@
	@echo '                "HW" :"pillF103",' >> $@
	@echo '                "CPU":"stm32f103c8t", "SERIES": "STM32F1"' >> $@
