#!/usr/bin/make -f

T  = $(abspath $(MAKEFILE_LIST))
S  = $(abspath $(dir $(T))     )
M ?= $(notdir $(T))
D  = $(abspath $(HOME)/$(M))

AUTHOR = $(shell git config user.name )
EMAIL  = $(shell git config user.email)
YEAR   = $(shell date +%Y)
ABOUT ?= as soon as possible

template:
	mkdir -p $(D)
	$(MAKE) -f $(T) -C $(D) M=$(M) \
		git readme apt format dirs giti doxy vscode cmake

.PHONY: git
git: .git
.git: .gitattributes
	git init
	git remote add gh    git@github.com:ponyatov/$(M).git
	git remote add flic git@gitflic.ru:dponyatov/$(M).git
	git checkout --orphan dev ; git checkout --orphan `whoami`
	ln -fs ../rc rc ; git add rc ; git commit -am "."
	git remote -v ; git branch -v
	google-chome https://github.com/new &
	google-chome https://gitflic.ru/project/create &

.gitattributes: $(S)/.gitattributes
	cp $< $@

.PHONY: readme
readme: README.md
README.md: $(T)
	echo '# `$(M)`'  > $@
	echo '## $(ABOUT)' >> $@
	echo '' >> $@
	echo '(c) $(AUTHOR) <<$(EMAIL)>> $(YEAR) MIT' >> $@
	echo '' >> $@
	echo '-  github: https://github.com/ponyatov/$(M)' >> $@
	echo '- gitflic: https://gitflic.ru/project/dponyatov/$(M)' >> $@

APT      = apt.Debian apt.Msys
APT_HEAD = 4

.PHONY: apt
apt: $(APT)
apt.%:
	head -n$(APT_HEAD) $(S)/$@ > $@ ; git add $@
	sudo apt update
	sudo apt install -uy `cat apt.$(shell lsb_release -si)`

FORMAT = .clang-format .prettierrc

.PHONY: format
format: $(FORMAT)

.clang-format: $(S)/.clang-format
	cp $< $@
.prettierrc:   $(S)/.prettierrc
	cp $< $@

DIRS = .vscode bin doc lib inc src tmp ref hw cpu arch os mk cmake

.PHONY: dirs
dirs: $(DIRS)
$(DIRS):
	mkdir -p $@

GITI = .gitignore $(foreach d,$(DIRS),$(d)/.gitignore)

.PHONY: giti
giti: $(GITI)

bin/.gitignore: $(T)
	echo '*' > $@
ref/.gitignore: $(T)
	echo '*' > $@
tmp/.gitignore: $(T)
	echo '*' > $@
doc/.gitignore: $(T)
	echo 'html/' > $@
.gitignore: $(S)/.gitignore $(T)
	cp $< $@

DOXY = .doxygen doc/logo.png doc/DoxygenLayout.xml

.PHONY: doxy
doxy: $(DOXY)

doc/DoxygenLayout.xml:
	doxygen -l ; mv DoxygenLayout.xml $@
.doxygen: $(S)/.doxygen $(T)
	@echo 'PROJECT_NAME           = "$(M)"'      > $@
	@echo 'PROJECT_BRIEF          = "$(ABOUT)"' >> $@
	tail -n+3 $< >> $@
doc/logo.png: $(S)/doc/logo.png
	cp $< $@

VSCODE = $(patsubst %,.vscode/%.json,settings extensions launch c_cpp_properties tasks)

.PHONY: vscode
vscode: $(VSCODE)

.vscode/%.json: $(S)/.vscode/%.json
	cp $< $@

CMAKE   = CMakeLists.txt CMakePresets.json
CMAKE_  = any_toolchain x86_64-linux-gnu x86_64-linux-musl arm-none-eabi
CMAKE_ += i686-w64-mingw32 mingw-w64-ucrt-x86_64 avr
CMAKE_ += FindRAGEL clean cross src syntax version
CMAKE  += $(patsubst %,cmake/%.cmake,$(CMAKE_))

.PHONY: cmake
cmake: $(CMAKE)

cmake/%.cmake: $(S)/cmake/%.cmake $(T)
	cp $< $@
CMakeLists.txt: $(S)/CMakeLists.txt $(T)
	cp $< $@
CMakePresets.json: $(S)/CMakePresets.json $(T)
	head -n2 $<      > $@
	@echo '    "buildPresets": [' >> $@
	@echo '        {' >> $@
	@echo '            "name":              "pillF103",' >> $@
	@echo '            "configurePreset":   "pillF103",' >> $@
	@echo '            "targets":          ["all","install"]' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"           :   "f4disco",' >> $@
	@echo '            "configurePreset":   "f4disco",' >> $@
	@echo '            "targets"        :  ["all","install"]' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"           :   "glibc",' >> $@
	@echo '            "configurePreset":   "glibc",' >> $@
	@echo '            "targets"        :  ["all","install"]' >> $@
	@echo '        }' >> $@
	@echo '    ],' >> $@
	@echo '    "configurePresets": [' >> $@
	@echo '        {' >> $@
	@echo '            "name"     : "common",' >> $@
	@echo '            "hidden"   :  true,' >> $@
	@echo '            "binaryDir": "$${sourceDir}/tmp/$${presetName}",' >> $@
	@echo '            "generator": "Unix Makefiles",' >> $@
	@echo '            "cacheVariables": {' >> $@
	@echo '                "CMAKE_INSTALL_PREFIX"    : "$${sourceDir}/bin",' >> $@
	@echo '                "CMAKE_MODULE_PATH"       : "$${sourceDir}/cmake",' >> $@
	@echo '                "CMAKE_COLOR_DIAGNOSTICS" : false,' >> $@
	@echo '                "CMAKE_BUILD_TYPE"        : "Debug",' >> $@
	@echo '                "CMAKE_VERBOSE_MAKEFILE"  : true' >> $@
	@echo '            }' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"          :  "cortexM",' >> $@
	@echo '            "hidden"        :   true,' >> $@
	@echo '            "inherits"      :  "common",' >> $@
	@echo '            "toolchainFile" :  "$${sourceDir}/cmake/arm-none-eabi.cmake",' >> $@
	@echo '            "cacheVariables": {"OS":"bare","CMAKE_EXECUTABLE_SUFFIX":".elf"}' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"          :  "cortexM3",' >> $@
	@echo '            "hidden"        :   true,' >> $@
	@echo '            "inherits"      :  "cortexM",' >> $@
	@echo '            "cacheVariables": {"ARCH":"cortexM3"}' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"          :  "cortexM4",' >> $@
	@echo '            "hidden"        :   true,' >> $@
	@echo '            "inherits"      :  "cortexM",' >> $@
	@echo '            "cacheVariables": {"ARCH":"cortexM4"}' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name": "pillF103",' >> $@
	@echo '            "inherits": "cortexM3",' >> $@
	@echo '            "cacheVariables": {' >> $@
	@echo '                "HW" :"pillF103",' >> $@
	@echo '                "CPU":"stm32f103c8t", "SERIES": "STM32F1"' >> $@
	@echo '            }' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"          : "f4disco",' >> $@
	@echo '            "inherits"      : "cortexM4",' >> $@
	@echo '            "cacheVariables": {' >> $@
	@echo '                "HW" :"f4disco",' >> $@
	@echo '                "CPU":"stm32f407vgt", "SERIES": "STM32F4"' >> $@
	@echo '            }' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"          : "pc",' >> $@
	@echo '            "inherits"      : "common",' >> $@
	@echo '            "hidden"        : true,' >> $@
	@echo '            "cacheVariables": {' >> $@
	@echo '                "HW":"pc", "CPU":"i5", "ARCH":"x86_64"' >> $@
	@echo '            }' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"          : "linux",' >> $@
	@echo '            "inherits"      : "pc",' >> $@
	@echo '            "hidden"        : true,' >> $@
	@echo '            "cacheVariables": {"OS":"linux"}' >> $@
	@echo '        },' >> $@
	@echo '        {' >> $@
	@echo '            "name"         : "glibc",' >> $@
	@echo '            "inherits"     : "linux",' >> $@
	@echo '            "displayName"  : "x86_64-linux-gnu",' >> $@
	@echo '            "description"  : "native host",' >> $@
	@echo '            "toolchainFile": "$${sourceDir}/cmake/x86_64-linux-gnu.cmake"' >> $@
	@echo '        }' >> $@
	@echo '   ]' >> $@
	@echo '}' >> $@

# any non-existent file
%:
	touch $@
