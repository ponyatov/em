#!/usr/bin/make -f

T  = $(abspath $(MAKEFILE_LIST))
S  = $(abspath $(dir $(T))     )
M ?= $(notdir $(CURDIR))
D  = $(abspath $(HOME)/$(M))

AUTHOR = $(shell git config user.name )
EMAIL  = $(shell git config user.email)
YEAR   = $(shell date +%Y)
ABOUT ?= as soon as possible

template:
	mkdir -p $(D)
	$(MAKE) -f $(T) -C $(D) M=$(M) \
		git dirs giti cross app vscode \
		readme license apt format doxy \
		mk cmake hw cpu arch os lib

.PHONY: git
git: .git
.git: .gitattributes
	git init
	git remote add gh    git@github.com:ponyatov/$(M).git
	git remote add flic git@gitflic.ru:dponyatov/$(M).git
	git checkout --orphan dev ; git checkout --orphan `whoami`
	ln -fs ../rc rc ; git add rc ; git commit -am "."
	git remote -v ; git branch -v
	google-chrome https://github.com/new &
	google-chrome https://gitflic.ru/project/create &

CROSS = hw cpu arch os
MKD   = mk cmake
DIRS  = .vscode bin doc lib inc src tmp ref $(CROSS) $(MKD)

.PHONY: dirs
dirs:
	mkdir -p $(DIRS)

GITI = .gitignore $(foreach d,$(DIRS),$(d)/.gitignore)

.PHONY: giti
giti: $(GITI)
	git add -f bin ref tmp

bin/.gitignore: $(T)
	echo '*' > $@
ref/.gitignore: $(T)
	echo '*' > $@
tmp/.gitignore: $(T)
	echo '*' > $@
doc/.gitignore: $(T)
	echo 'html/' > $@
.gitignore: $(S)/.gitignore $(T)
	cp $< $@

CROSSD = $(foreach d,$(CROSS),$(d)/inc $(d)/src)
CROSSI = $(foreach i,$(CROSS) $(CROSSD),$(i)/.gitignore)
CROSSC = $(foreach c,$(CROSS),$(c)/inc/$(c).hpp $(c)/src/$(c).cpp) hw/inc/cross.hpp

.PHONY: cross
cross: $(CROSS) $(CROSSD) $(CROSSI)
	touch $(CROSSC)

$(CROSS) $(CROSSD):
	mkdir -p $@

APP = inc/app.hpp src/app.cpp src/main.cpp lib/app.ini

.PHONY: app
app: $(APP)

VSCODE  = settings extensions launch c_cpp_properties tasks
VSCODE := $(patsubst %,.vscode/%.json,$(VSCODE))

.PHONY: vscode
vscode: $(VSCODE)

.vscode/%: $(S)/.vscode/%
	cp $< $@

.PHONY: readme
readme: README.md
README.md: $(T)
	echo '# `$(M)`'  > $@
	echo '## $(ABOUT)' >> $@
	echo '' >> $@
	echo '(c) $(AUTHOR) <<$(EMAIL)>> $(YEAR) MIT' >> $@
	echo '' >> $@
	echo '-  github: https://github.com/ponyatov/$(M)' >> $@
	echo '- gitflic: https://gitflic.ru/project/dponyatov/$(M)' >> $@

.PHONY: license
license: LICENSE
LICENSE: $(T)
	@echo 'MIT License' > $@
	@echo '' >> $@
	@echo 'Copyright (c) $(YEAR) $(AUTHOR) <$(EMAIL)>' >> $@
	@echo '' >> $@
	tail -n+5 $(S)/$@ >> $@

APT      = apt.Debian apt.Msys
APT_HEAD = 4

.PHONY: apt
apt: $(APT)
	sudo apt update
	sudo apt install -uy `cat apt.$(shell lsb_release -si)`
apt.%:
	head -n$(APT_HEAD) $(S)/$@ > $@

FORMAT = .clang-format .prettierrc

.PHONY: format
format: $(FORMAT)

.clang-format: $(S)/.clang-format
	cp $< $@
.prettierrc:   $(S)/.prettierrc
	cp $< $@

DOXY = .doxygen doc/logo.png doc/DoxygenLayout.xml

.PHONY: doxy
doxy: $(DOXY)

doc/DoxygenLayout.xml:
	doxygen -l ; mv DoxygenLayout.xml $@
.doxygen: $(S)/.doxygen $(T)
	@echo 'PROJECT_NAME           = "$(M)"'      > $@
	@echo 'PROJECT_BRIEF          = "$(ABOUT)"' >> $@
	tail -n+3 $< >> $@
doc/logo.png: $(S)/doc/logo.png
	cp $< $@

MK  = var version cross dirs tool pkg src cfg
MK += all debug clean format rule doc libc install merge docker
MKM = $(foreach m,$(MK),mk/$(m).mk)

.PHONY: mk
mk: Makefile $(MKM) mk/patch.mk
Makefile: $(T)
	echo $(foreach m,$(MKM),include_$(m)) | tr ' ' '\n' | tr '_' ' ' > $@
mk/%: $(S)/mk/% $(T)
	cp $< $@

CMAKE   = CMakeLists.txt CMakePresets.json
CMAKE_  = any_toolchain x86_64-linux-gnu arm-none-eabi
CMAKE_ += version src syntax FindRAGEL cross clean
CMAKE  += $(patsubst %,cmake/%.cmake,$(CMAKE_))

.PHONY: cmake
cmake: $(CMAKE)

cmake/%.cmake: $(S)/cmake/%.cmake $(T)
	cp $< $@
CMakeLists.txt: $(S)/CMakeLists.txt
	cp $< $@
CMakePresets.json: $(T)
	@echo '{' > $@
