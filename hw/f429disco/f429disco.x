/* STM32F429ZIT6 @ STM32F429I-DISC1 */
MEMORY
{
    FLASH (r x) : ORIGIN = 0x08000000, LENGTH = 1024K
    RAM   (rwx) : ORIGIN = 0x20000000, LENGTH =  192K 
    CCM   (rwx) : ORIGIN = 0x10000000, LENGTH =   64K
    SDRAM (rwx) : ORIGIN = 0xD0000000, LENGTH = 8192K
    QSPI  (r x) : ORIGIN = 0x90000000, LENGTH =   64M
    LCD   (rwx) : ORIGIN = 0xC0000000, LENGTH =  512K
}
