set_target_properties(${CMAKE_PROJECT_NAME}
    PROPERTIES OUTPUT_NAME ${BIN_OUTPUT_NAME})

install(TARGETS ${CMAKE_PROJECT_NAME} DESTINATION ${CMAKE_INSTALL_PREFIX})

if (CMAKE_HOST_SYSTEM_NAME STREQUAL CMAKE_SYSTEM_NAME) # HOST

add_custom_command(
    TARGET              ${CMAKE_PROJECT_NAME} POST_BUILD
    WORKING_DIRECTORY   ${CMAKE_SOURCE_DIR}
    COMMAND             ${CMAKE_COMMAND} -E create_symlink
    ARGS                ${BIN_OUTPUT_NAME}${CMAKE_EXECUTABLE_SUFFIX}
                        ${CMAKE_INSTALL_PREFIX}/${CMAKE_PROJECT_NAME}${CMAKE_EXECUTABLE_SUFFIX})

add_custom_command(
    TARGET              ${CMAKE_PROJECT_NAME} POST_BUILD
    WORKING_DIRECTORY   ${CMAKE_SOURCE_DIR}
    COMMAND             $<TARGET_FILE:${CMAKE_PROJECT_NAME}> ${INI}
)

else() # TARGET

add_custom_command(
    TARGET              ${CMAKE_PROJECT_NAME} POST_BUILD
    WORKING_DIRECTORY   ${CMAKE_SOURCE_DIR}
    COMMAND             ${CMAKE_CROSSCOMPILING_EMULATOR} $<TARGET_FILE:${CMAKE_PROJECT_NAME}> ${INI}
)

endif()
