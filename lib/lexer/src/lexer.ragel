#include "os.hpp"
#include "lexer.hpp"

%%{
    machine lexer;

    shebang      = '#!' [^\n]*;
    line_comment = '//' [^\n]*;

    block_comment := |*
        '\n' => { yyline++;   };
        '*/' => { fgoto main; };
        any  => {             };
    *|;

    sign    = [+\-];
    integer = sign? digit+;
    hex     = '0x' xdigit+;
    oct     = '0o' [0-7]+;
    bin     = '0b' [01]+;
    float   = sign? digit+ '.' digit+;
    exp     = (integer|float) [eE] sign? digit+;

    main := |*
        '\n'         => { yyline++; };
        shebang      => {};
        line_comment => {};
        '/*'         => { fgoto block_comment; };
        hex          => { fprintf(stderr,  "hex: %x\n",  to_hex(ts,te)); };
        oct          => { fprintf(stderr,  "oct: %o\n",  to_oct(ts,te)); };
        bin          => { fprintf(stderr,  "bin: %d\n",  to_bin(ts,te)); };
        integer      => { fprintf(stderr,  "int: %d\n",  to_int(ts,te)); };
        float        => { fprintf(stderr,"float: %f\n",to_float(ts,te)); };
        exp          => { fprintf(stderr,"float: %f\n",to_float(ts,te)); };
        space        => {};
        any          => { fprintf(stderr, "\n\n%s:%d lexer error: %c\n\n",
                                        yyfile, yyline, *ts); exit(-1); };
    *|;

}%%

%%write data;
char *yyfile = nullptr;  ///< current file name
int yyline = 1;          ///< current line number

void lexer(char *p, char *pe) {
    char *eof = pe;
    int cs = lexer_start; int act;
    char *ts, *te;
    yyline = 1;
    %%write init;
    %%write exec;
}
