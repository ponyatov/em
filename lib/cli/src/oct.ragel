#include <stdint.h>

%%machine oct;
%%write data;

static uint32_t ret      = 0;    ///< result number
static     bool positive = true; ///< sign flag

int oct(char *p, char *pe) {
    ret = 0;
    int cs = 0, act = 0;
    char *ts = nullptr, *te = nullptr, *eof = pe;
    %%write init;
    %%write exec;
    if (positive) return +ret; else return -ret;
}

%%{
    main := |*
        "0o"  => {                                  };
        '+'   => { positive =  true;                };
        '-'   => { positive = false;                };
        [0-7] => { ret = ret << 3 | (ts[0] - '0' ); };
    *|;
}%%
