{
    "version": 6,
    "buildPresets": [
        {
            "name"           :   "f4disco",
            "configurePreset":   "f4disco",
            "targets"        :  ["all","install"]
        },
        {
            "name":              "iskra",
            "configurePreset":   "iskra",
            "targets":          ["all","install"]
        },
        {
            "name":              "pillF030",
            "configurePreset":   "pillF030",
            "targets":          ["all","install"]
        },
        {
            "name":              "pillF103",
            "configurePreset":   "pillF103",
            "targets":          ["all","install"]
        },
        {
            "name":              "l496disco",
            "configurePreset":   "l496disco",
            "targets":          ["all","install"]
        },
        {
            "name":              "musl",
            "configurePreset":   "musl",
            "targets":          ["all","install"]
        },
        {
            "name"           :   "glibc",
            "configurePreset":   "glibc",
            "targets"        :  ["all","install"]
        }
    ],
    "configurePresets": [
        {
            "name"     : "common",
            "hidden"   :  true,
            "binaryDir": "${sourceDir}/tmp/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX"    : "${sourceDir}/bin",
                "CMAKE_MODULE_PATH"       : "${sourceDir}/cmake",
                "CMAKE_COLOR_DIAGNOSTICS" : false,
                "CMAKE_BUILD_TYPE"        : "Debug",
                "CMAKE_VERBOSE_MAKEFILE"  : true
            }
        },
        {
            "name"          : "mingw32",
            "inherits"      : "pc",
            "displayName"   : "i686-w64-mingw32",
            "description"   : "mingw/32",
            "toolchainFile" : "${sourceDir}/cmake/i686-w64-mingw32.cmake",
            "cacheVariables": {"ARCH":"i386","OS":"mingw"}
        },
        {
            "name"          : "ucrt",
            "inherits"      : "pc",
            "displayName"   : "mingw-w64-ucrt-x86_64",
            "description"   : "mingw/64",
            "toolchainFile" : "${sourceDir}/cmake/mingw-w64-ucrt-x86_64.cmake",
            "cacheVariables": {"ARCH":"x86_64","OS":"mingw"}
        },
        {
            "name"          :  "cortexM",
            "hidden"        :   true,
            "inherits"      :  "common",
            "toolchainFile" :  "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {"OS":"bare","CMAKE_EXECUTABLE_SUFFIX":".elf"}
        },
        {
            "name"          :  "cortexM0",
            "hidden"        :   true,
            "inherits"      :  "cortexM",
            "cacheVariables": {"ARCH":"cortexM0"}
        },
        {
            "name"          :  "cortexM3",
            "hidden"        :   true,
            "inherits"      :  "cortexM",
            "cacheVariables": {"ARCH":"cortexM3"}
        },
        {
            "name"          :  "cortexM4",
            "hidden"        :   true,
            "inherits"      :  "cortexM",
            "cacheVariables": {"ARCH":"cortexM4"}
        },
        {
            "name"          : "f4disco",
            "inherits"      : "cortexM4",
            "cacheVariables": {
                "HW" :"f4disco",
                "CPU":"stm32f407vgt", "SERIES": "STM32F4"
            }
        },
        {
            "name": "iskra",
            "inherits": "cortexM4",
            "cacheVariables": {
                "HW" :"iskra",
                "CPU":"stm32f405rgt", "SERIES": "STM32F4"
            }
        },
        {
            "name": "l496disco",
            "inherits": "cortexM4",
            "cacheVariables": {
                "HW" :"l496disco",
                "CPU":"stm32l496agi", "SERIES": "STM32L4"
            }
        },
        {
            "name": "pillF030",
            "inherits": "cortexM0",
            "cacheVariables": {
                "HW" :"pillF030",
                "CPU":"stm32f030f4p", "SERIES": "STM32F0"
            }
        },
        {
            "name": "pillF103",
            "inherits": "cortexM3",
            "cacheVariables": {
                "HW" :"pillF103",
                "CPU":"stm32f103c8t", "SERIES": "STM32F1"
            }
        },
        {
            "name"          : "pc",
            "inherits"      : "common",
            "hidden"        : true,
            "cacheVariables": {
                "HW":"pc", "CPU":"i5", "ARCH":"x86_64"
            }
        },
        {
            "name"          : "linux",
            "inherits"      : "pc",
            "hidden"        : true,
            "cacheVariables": {"OS":"linux"}
        },
        {
            "name"         : "musl",
            "inherits"     : "linux",
            "displayName"  : "x86_64-linux-musl",
            "description"  : "busybox:musl/docker",
            "toolchainFile": "${sourceDir}/cmake/x86_64-linux-musl.cmake"
       },
       {
            "name"       : "glibc",
            "inherits"   : "linux",
            "displayName": "x86_64-linux-gnu",
            "description": "native host",
            "toolchainFile": "${sourceDir}/cmake/x86_64-linux-gnu.cmake"
        }
   ]
}
