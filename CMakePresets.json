{
    "version": 6,
    "buildPresets": [
        {
            "name":              "linux",
            "configurePreset":   "linux",
            "targets":          ["all","install"]
        },
        {
            "name":              "mingw",
            "configurePreset":   "mingw",
            "targets":          ["all","install"]
        },
        {
            "name":              "pillF030",
            "configurePreset":   "pillF030",
            "targets":          ["all","install"]
        },
        {
            "name":              "pillF103",
            "configurePreset":   "pillF103",
            "targets":          ["all","install"]
        },
        {
            "name":              "l496disco",
            "configurePreset":   "l496disco",
            "targets":          ["all","install"]
        }
    ],
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "binaryDir": "${sourceDir}/tmp/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_VERBOSE_MAKEFILE": true,
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux",
            "inherits": "common",
            "displayName": "x86_64-linux-gnu",
            "description": "native host",
            "toolchainFile": "${sourceDir}/cmake/x86_64-linux-gnu.cmake",
            "cacheVariables": {
                "HW":"pc", "CPU":"i5", "ARCH":"x86_64", "OS":"linux"
            }
        },
        {
            "name": "mingw",
            "inherits": "common",
            "displayName": "mingw-w64-ucrt-x86_64",
            "description": "native win64",
            "toolchainFile": "${sourceDir}/cmake/mingw-w64-ucrt-x86_64.cmake",
            "cacheVariables": {
                "HW":"pc", "CPU":"i5", "ARCH":"x86_64", "OS":"mingw"
            }
        },
        {
            "name": "cortexM",
            "hidden": true,
            "inherits": "common",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {"OS":"bare"}
        },
        {
            "name": "cortexM0",
            "hidden": true,
            "inherits": "cortexM",
            "cacheVariables": {"ARCH":"cortexM0"}
        },
        {
            "name": "cortexM3",
            "hidden": true,
            "inherits": "cortexM",
            "cacheVariables": {"ARCH":"cortexM3"}
        },
        {
            "name": "cortexM4",
            "hidden": true,
            "inherits": "cortexM",
            "cacheVariables": {"ARCH":"cortexM4"}
        },
        {
            "name": "pillF030",
            "inherits": "cortexM0",
            "cacheVariables": {
                "HW" :"pillF030",
                "CPU":"stm32f030f4p", "SERIES": "STM32F0"
            }
        },
        {
            "name": "l496disco",
            "inherits": "cortexM4",
            "cacheVariables": {
                "HW" :"l496disco",
                "CPU":"stm32l496agi", "SERIES": "STM32L4"
            }
        },
        {
            "name": "stm32l496g",
            "inherits": "cortexM4",
            "cacheVariables": {
                "HW" :"stm32l496g", "SERIES": "STM32L4",
                "CPU":"STM32L496AGI"
            }
        }
    ]
}
