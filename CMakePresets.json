{
    "version": 6,
    "buildPresets": [
        {
            "name"            :  "pillF030",
            "configurePreset" :  "pillF030",
            "targets"         : ["all","install"]
        },
        {
            "name"            :  "pillF103",
            "configurePreset" :  "pillF103",
            "targets"         : ["all","install"]
        },
        {
            "name"            :  "iskra",
            "configurePreset" :  "iskra",
            "targets"         : ["all","install"]
        },
        {
            "name"            :  "f4disco",
            "configurePreset" :  "f4disco",
            "targets"         : ["all","install"]
        },
        {
            "name"            :  "l496disco",
            "configurePreset" :  "l496disco",
            "targets"         : ["all","install"]
        },
        {
            "name"            :  "f429disco",
            "configurePreset" :  "f429disco",
            "targets"         : ["all","install"]
        },
        {
            "name"            :  "esp8266",
            "configurePreset" :  "esp8266",
            "targets"         : ["all","install"]
        },
        {
            "name"            :  "rpi3bp",
            "configurePreset" :  "rpi3bp",
            "targets"         : ["all","install"]
        },
        {
            "name"            :  "win32",
            "configurePreset" :  "win32",
            "targets"         : ["all",",nstall"]
        },
        {
            "name"            :  "linux",
            "configurePreset" :  "linux",
            "targets"         : ["all","install"]
        }
    ],
    "configurePresets": [
        {
            "name"            : "common",
            "hidden"          :  true,
            "binaryDir"       : "${sourceDir}/tmp/${presetName}",
            "generator"       : "Unix Makefiles",
            "cacheVariables"  : {
                "CMAKE_INSTALL_PREFIX"    : "${sourceDir}/bin",
                "CMAKE_MODULE_PATH"       : "${sourceDir}/cmake",
                "CMAKE_COLOR_DIAGNOSTICS" :  false,
                "CMAKE_BUILD_TYPE"        : "Debug",
                "CMAKE_VERBOSE_MAKEFILE"  :  false
            }
        },
        {
            "name"            : "cortexm",
            "inherits"        : "common",
            "hidden"          : true,
            "toolchainFile"   : "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables"  : {"OS":"none"}
        },
        {
            "name"            : "cortexm0",
            "inherits"        : "cortexm",
            "hidden"          : true,
            "cacheVariables"  : {"ARCH":"cortexm0"}
        },
        {
            "name"            : "cortexm3",
            "inherits"        : "cortexm",
            "hidden"          : true,
            "cacheVariables"  : {"ARCH":"cortexm3"}
        },
        {
            "name"            : "cortexm4",
            "inherits"        : "cortexm",
            "hidden"          : true,
            "cacheVariables"  : {"ARCH":"cortexm4"}
        },
        {
            "name"            : "pillF030",
            "inherits"        : "cortexm0",
            "cacheVariables"  : {"HW" :"pillF030",
                                "CPU":"stm32f030f4", "SERIES": "STM32F0"
            }
        },
        {
            "name"            :  "pillF103",
            "inherits"        :  "cortexm3",
            "cacheVariables"  : {"HW" :"pillF103",
                                "CPU":"stm32f103c8", "SERIES": "STM32F1"}
        },
        {
            "name"            : "iskra",
            "inherits"        : "cortexm4",
            "cacheVariables"  : {"HW" :"iskra",
                                "CPU":"stm32f405rg", "SERIES": "STM32F4"}
        },
        {
            "name"            : "f4disco",
            "inherits"        : "cortexm4",
            "cacheVariables"  : {"HW" :"f4disco",
                                "CPU":"stm32f407vg", "SERIES": "STM32F4"}
        },
        {
            "name"            : "l496disco",
            "inherits"        : "cortexm4",
            "cacheVariables"  : {"HW":"l496disco", "CPU":"stm32l496ag"}
        },
        {
            "name"            : "f429disco",
            "inherits"        : "cortexm4",
            "cacheVariables"  : {"HW":"f429disco", "CPU":"stm32f429zi"}
        },
        {
            "name"            : "armv7",
            "inherits"        : "common",
            "hidden"          : true,
            "cacheVariables"  : {"ARCH":"armv7", "OS":"linux"}
        },
        {
            "name"            : "rpi3bp",
            "inherits"        : "armv7",
            "hidden"          : false,
            "cacheVariables"  : {"HW":"rpi3bp", "CPU":"bcm2837"}
        },
        {
            "name"            : "pc",
            "inherits"        : "common",
            "hidden"          : true,
            "cacheVariables"  : {"HW":"pc", "CPU":"i5", "ARCH":"x86_64"}
        },
        {
            "name"            : "ucrt",
            "inherits"        : "pc",
            "displayName"     : "mingw-w64-ucrt-x86_64",
            "description"     : "mingw/64",
            "toolchainFile"   : "${sourceDir}/cmake/mingw-w64-ucrt-x86_64.cmake",
            "cacheVariables"  : {"ARCH":"x86_64", "OS":"win64"}
        },
        {
            "name"            : "musl",
            "inherits"        : "linux",
            "displayName"     : "x86_64-linux-musl",
            "description"     : "busybox:musl/docker",
            "toolchainFile"   : "${sourceDir}/cmake/x86_64-linux-musl.cmake"
        },
        {
            "name"            : "win32",
            "inherits"        : "pc",
            "displayName"     : "i686-w64-mingw32",
            "toolchainFile"   : "${sourceDir}/cmake/i686-w64-mingw32.cmake",
            "cacheVariables"  : {"CPU":"i686", "ARCH":"i386", "OS":"win32"}
        },
        {
            "name"            : "linux",
            "inherits"        : "pc",
            "displayName"     : "x86_64-linux-gnu",
            "toolchainFile"   : "${sourceDir}/cmake/x86_64-linux-gnu.cmake",
            "cacheVariables"  : {"OS":"linux"}
        }
    ]
}
